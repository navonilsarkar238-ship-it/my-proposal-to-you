<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Happy Birthday!</title>
    <style>
        body {
            margin: 0;
            height: 100vh;
            background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 99%, #fecfef 100%);
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .card {
            text-align: center;
            background: rgba(255, 255, 255, 0.85);
            padding: 40px 60px;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            z-index: 10;
            animation: popUp 1.2s ease-in-out;
        }

        h1 {
            color: #d63384;
            font-size: 2.5rem;
            margin-bottom: 10px;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.1);
        }

        p {
            color: #555;
            font-size: 1.2rem;
            margin-top: 0;
        }

        /* Floating Hearts Styling */
        .heart {
            position: absolute;
            color: #ff4d6d;
            font-size: 20px;
            user-select: none;
            pointer-events: none;
            animation: floatUp 4s linear infinite;
        }

        @keyframes floatUp {
            0% {
                transform: translateY(100vh) scale(0.5);
                opacity: 1;
            }
            100% {
                transform: translateY(-10vh) scale(1.2);
                opacity: 0;
            }
        }

        @keyframes popUp {
            0% {
                transform: scale(0);
                opacity: 0;
            }
            80% {
                transform: scale(1.05);
                opacity: 1;
            }
            100% {
                transform: scale(1);
                opacity: 1;
            }
        }
    </style>
</head>
<body>

    <div class="card">
        <h1>Happy Birthday! 🎉</h1>
        <p>Wishing the prettiest smile the best day ever. ✨</p>
    </div>

    <script>
        // Function to create floating hearts dynamically
        function createHeart() {
            const heart = document.createElement('div');
            heart.classList.add('heart');
            heart.innerHTML = '❤️';
            
            // Random horizontal starting position
            heart.style.left = Math.random() * 100 + 'vw';
            
            // Random animation speed and size
            const duration = Math.random() * 2 + 3; // between 3s and 5s
            const size = Math.random() * 20 + 15; // between 15px and 35px
            
            heart.style.animationDuration = duration + 's';
            heart.style.fontSize = size + 'px';
            
            document.body.appendChild(heart);
            
            // Remove heart after animation finishes
            setTimeout(() => {
                heart.remove();
            }, duration * 1000);
        }

        // Generate a new heart every 300 milliseconds
        setInterval(createHeart, 300);
    </script>

</body>
</html>
